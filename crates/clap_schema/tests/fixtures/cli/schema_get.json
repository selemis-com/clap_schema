{
  "path": [
    "get"
  ],
  "description": "Show one resource",
  "input": {
    "schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "Arguments used to fetch a resource.",
      "properties": {
        "id": {
          "description": "Identifier of the resource to fetch.",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "GetArgs",
      "type": "object"
    },
    "transports": [
      {
        "kind": "arguments",
        "bindings": {
          "id": {
            "argument": "id",
            "invocation": {
              "kind": "positional",
              "index": 1,
              "value": {
                "min": 1,
                "max": 1,
                "repeat": false
              },
              "after_double_dash": false
            },
            "encoding": "text"
          }
        }
      }
    ]
  },
  "output": {
    "format": "json",
    "schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "Resource returned by the get command.",
      "properties": {
        "id": {
          "description": "Stable resource identifier.",
          "type": "string"
        },
        "name": {
          "description": "Human-readable resource name.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "Resource",
      "type": "object"
    },
    "selector": {
      "kind": "flag",
      "argument": {
        "kind": "flag",
        "long": "json",
        "present_value": true
      }
    }
  }
}
